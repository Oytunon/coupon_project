FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY backend_api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy shared package
COPY shared /app/shared

# Copy worker script
COPY stats_worker.py /app/stats_worker.py

# Set Python path
ENV PYTHONPATH=/app

# Run the worker with unbuffered output
CMD ["python", "-u", "stats_worker.py"]
