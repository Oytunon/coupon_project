# ============================================
# COUPON PROJESİ - Ortam Değişkenleri
# ============================================
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizi girin

# ==================== Veritabanı Ayarları ====================
# PostgreSQL bağlantı adresi (Docker varsayılan ayarları)
DATABASE_URL=postgresql://coupon_user:coupon_pass@localhost:5432/coupon_db

# ==================== Güvenlik Ayarları (ZORUNLU) ====================
# UYARI: Production'da bu değerleri mutlaka değiştirin!

# JWT token imzalama için gizli anahtar (ZORUNLU)
# Minimum 32 karakter, güçlü ve rastgele olmalı
# Oluşturmak için: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production

# API güvenlik token'ı - Backend-to-Backend iletişim için (ZORUNLU)
API_TOKEN=

# ==================== Betconstruct API Ayarları ====================
# Betconstruct servislerine erişim için gerekli API anahtarı (ZORUNLU)
# Kupon ve yatırım (deposit) servisleri için ZORUNLUDUR
BAPI_TOKEN=

# ==================== Mailgun Email Ayarları ====================
# Mailgun hesabınızdan alacağınız bilgiler
# https://app.mailgun.com/ adresinden ücretsiz hesap oluşturabilirsiniz

# Mailgun API Key (ZORUNLU - Admin login için)
# Dashboard > API Keys > Private API key
MAILGUN_API_KEY=your-mailgun-api-key

# Mailgun Domain (ZORUNLU - Admin login için)
# Dashboard > Sending > Domains
# Örnek: mg.yourdomain.com veya sandbox123.mailgun.org
# Not: Tam domain adını girin (https:// olmadan)
MAILGUN_DOMAIN=your-mailgun-domain

# Mailgun API Base URL (Bölgenize göre)
# EU customers: https://api.eu.mailgun.net (Avrupa sunucuları)
# US customers: https://api.mailgun.net (Amerika sunucuları - default)
# Dashboard'da "EU" veya "US" region'ını kontrol edin
MAILGUN_BASE_URL=https://api.eu.mailgun.net

# Gönderen email adresi (Mailgun domain'inizle uyumlu olmalı)
# Örnek: noreply@mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@yourdomain.com

# Gönderen adı (Email'de görünecek isim)
MAILGUN_FROM_NAME=Extrabet Admin

# Magic link gönderilecek frontend URL
MAGIC_LINK_URL=http://localhost:3000/verify-magic-link

# ==================== Kupon Kuralları (Opsiyonel - Varsayılan Değerler) ====================
# Bu değerler tanımlanmazsa uygulama içindeki varsayılanlar kullanılır

# Minimum kupon tutarı (TL)
# MIN_STAKE=100.0

# Minimum maç / kombine sayısı
# MIN_COMBINATION=2

# Her maç için minimum oran
# MIN_ODD=1.50

# ==================== Sunucu Ayarları (Opsiyonel - Varsayılan Değerler) ====================
# Bu ayarlar tanımlanmazsa uygulama varsayılan değerlerle çalışır

# API'nin dinleyeceği adres
# API'nin dinleyeceği adres (Default: 0.0.0.0)
API_HOST=0.0.0.0

# API'nin çalışacağı port (Default: 8000)
API_PORT=8000

# CORS Ayarları (Virgülle ayrılmış domain listesi)
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5175,http://localhost:3000

# Frontend URL (Eski ayar - CORS_ORIGINS kullanılması önerilir)
FRONTEND_URL=http://localhost:5173

